# ==========================================
# AVYANTRIX AUTH V1 — ENVIRONMENT CONFIGURATION
# ==========================================

# Application URL
NEXT_PUBLIC_APP_URL="https://auth.avyantrix.com"
APP_URL="https://auth.avyantrix.com"
NODE_ENV="development"

# Neon PostgreSQL Database (Pooled & Direct)
DATABASE_URL="postgresql://neondb_owner:password@ep-dark-resonance-azrvwd8c-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:password@ep-dark-resonance-azrvwd8c.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Session & OIDC Security Secrets
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-32-byte-random-auth-secret"
OIDC_JWT_SECRET="your-32-byte-random-oidc-secret"
SESSION_COOKIE_NAME="avy_auth_session"
SESSION_MAX_AGE_SECONDS=2592000 # 30 days

# Admin Bootstrap Secret (for pnpm run admin:bootstrap)
ADMIN_BOOTSTRAP_SECRET="your-founder-bootstrap-secret-key"

# Stalwart Mail Server SMTP (mail.avyantrix.com)
SMTP_HOST="mail.avyantrix.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="noreply@avyantrix.com"
SMTP_PASSWORD="your-secure-stalwart-password"
SMTP_FROM="Avyantrix ID <noreply@avyantrix.com>"

# OAuth Providers (Google & GitHub)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
