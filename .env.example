# ==========================================
# AVYANTRIX AUTH V1 — ENVIRONMENT CONFIGURATION
# ==========================================

# Application URL
NEXT_PUBLIC_APP_URL="https://auth.avyantrix.com"
NODE_ENV="development"

# Neon PostgreSQL Connection (Prisma)
# DATABASE_URL uses pooled connection (pgbouncer)
# DIRECT_URL uses direct connection for schema migrations
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/avyantrix_auth?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/avyantrix_auth?sslmode=require"

# Session & Security Secrets
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-32-byte-base64-random-secret"
SESSION_COOKIE_NAME="avy_auth_session"
SESSION_MAX_AGE_SECONDS=2592000 # 30 days

# Google OAuth 2.0 / OIDC
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Stalwart Mail Server SMTP
SMTP_HOST="mail.avyantrix.com"
SMTP_PORT=587
SMTP_SECURE="false" # STARTTLS on 587, SSL on 465
SMTP_USER="no-reply@avyantrix.com"
SMTP_PASSWORD="your-secure-smtp-password"
SMTP_FROM="Avyantrix Identity <no-reply@avyantrix.com>"

# Redis / Upstash (Optional - for distributed rate limiting & transient cache)
REDIS_URL="redis://default:password@sample.upstash.io:6379"
